DirectoryIndex index.html index.php

RewriteEngine On

# --- Canonical host: force https + non-www in a single 301 hop ---
# Fixes the 5 duplicate URL variants GSC reports (http://, http://www, https://www, /index.html)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# --- /index.html -> / (removes the duplicate homepage URL) ---
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
